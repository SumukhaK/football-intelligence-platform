{
  "displayName": "football-api: 5xx error rate over 5%",
  "documentation": {
    "content": "More than 5% of requests answered 5xx for 10 minutes, with at least 20 requests.\n\nFirst check: Error Reporting and `app.crash` / `app.error` log lines for the revision, then `component.load` events from the last startup.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "5xx share over 5% with 20+ requests",
      "conditionPrometheusQueryLanguage": {
        "query": "(sum(increase(logging_googleapis_com:user_api_requests{monitored_resource=\"cloud_run_revision\",status_class=\"5\"}[10m])) / sum(increase(logging_googleapis_com:user_api_requests{monitored_resource=\"cloud_run_revision\"}[10m])) > 0.05) and (sum(increase(logging_googleapis_com:user_api_requests{monitored_resource=\"cloud_run_revision\"}[10m])) >= 20)",
        "duration": "600s",
        "evaluationInterval": "60s"
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "86400s"
  },
  "severity": "ERROR"
}
