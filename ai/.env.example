# Backend settings (ai/backend/app/config.py). Copy to ai/.env and edit.
# Every value below is the default, so an empty .env works for local
# development. Paths are relative to the ai/ folder, where the server runs.
# No secrets are needed: the model, data and LLM all run locally.

# --- Models and data ---
MODEL_PATH=../ai/models/latest/model.joblib
REGISTRY_PATH=../ai/models/registry.json
# Newest live or completed-season match dataset is loaded from here (ADR 008).
MATCHES_DIR=../datasets/processed/football_data
# Root of raw and processed data, used by the daily refresh.
DATASETS_DIR=../datasets

# --- Leagues (ADR 012) ---
# JSON list of served leagues; requests that name no league get the default.
SERVED_COMPETITIONS=["Premier League","Bundesliga","La Liga","Serie A","Ligue 1"]
DEFAULT_COMPETITION=Premier League

# --- Daily data refresh (ADR 013) ---
# Local hour (0-23) to download the latest results; `off` turns it off.
LIVE_REFRESH_HOUR=6

# --- Predictions ---
# Draw probability at or above which /predict flags draw_possible (ADR 011).
DRAW_POSSIBLE_THRESHOLD=0.28

# --- Server ---
API_VERSION=0.1.0
LOG_LEVEL=INFO

# --- AI assistant (local Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
ASSISTANT_VECTOR_STORE_PATH=assistant/vector_store
ASSISTANT_KNOWLEDGE_ROOT=.
ASSISTANT_TOP_K=5
