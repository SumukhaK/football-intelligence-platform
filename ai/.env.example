# Backend settings (ai/backend/app/config.py). Copy to ai/.env and edit.
# Every value below is the default, so an empty .env works for local
# development. Paths are relative to the ai/ folder, where the server runs.
# No secrets are needed: the model, data and LLM all run locally.

# --- Models and data ---
MODEL_PATH=../ai/models/latest/model.joblib
REGISTRY_PATH=../ai/models/registry.json
# API v1 and the unversioned paths keep the original model (ADR 014).
V1_MODEL_PATH=../ai/models/runs/20260630_132617/model.joblib
V1_MODEL_VERSION=20260630_132617
# Newest live or completed-season match dataset is loaded from here (ADR 008).
MATCHES_DIR=../datasets/processed/football_data
# Root of raw and processed data, used by the daily refresh.
DATASETS_DIR=../datasets
# Upcoming fixtures, rebuilt by the daily refresh (ADR 015).
FIXTURES_DIR=../datasets/processed/openfootball

# --- Leagues (ADR 012) ---
# JSON list of served leagues; requests that name no league get the default.
SERVED_COMPETITIONS=["Premier League","Bundesliga","La Liga","Serie A","Ligue 1"]
DEFAULT_COMPETITION=Premier League

# --- Daily data refresh (ADR 013) ---
# Local hour (0-23) to download the latest results; `off` turns it off.
LIVE_REFRESH_HOUR=6

# --- Predictions ---
# Draw probability at or above which /predict flags draw_possible (ADR 011).
DRAW_POSSIBLE_THRESHOLD=0.28

# --- Server ---
API_VERSION=2.0.0
LOG_LEVEL=INFO
# `json` writes one JSON object per log line in the telemetry contract's format
# (ADR 024); `text` is easier to read locally.
LOG_FORMAT=text
# Google Cloud project, used for the trace field on JSON log lines; unset locally.
# GCP_PROJECT_ID=
# K_REVISION is set by Cloud Run and logged as `revision`; leave it unset locally.
# Requests per minute per client address before a 429 (ADR 014); `off` turns it off.
RATE_LIMIT_PER_MINUTE=120

# --- AI assistant (local Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
ASSISTANT_VECTOR_STORE_PATH=assistant/vector_store
ASSISTANT_KNOWLEDGE_ROOT=.
ASSISTANT_TOP_K=5

# Invite-only sign-in (ADR 022). Off locally; true in staging and production.
AUTH_REQUIRED=false
ACCOUNTS_PATH=accounts/accounts.json

# Team and league crest URL tables (ADR 020).
TEAM_CRESTS_PATH=../datasets/schemas/team_crests.csv
LEAGUE_EMBLEMS_PATH=../datasets/schemas/league_emblems.csv
