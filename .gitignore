# =============================================================================
# Datasets and models
# =============================================================================
# Keep the folders (CI checks they exist) but never their data
datasets/raw/*
!datasets/raw/.gitkeep
datasets/interim/
datasets/external/
ai/models/*.pkl
ai/models/*.joblib
ai/models/*.json
ai/models/*.ubj
models/runs/
models/latest/

# AI pipeline outputs (trained models, reports, explanations)
ai/models/runs/
ai/models/latest/
ai/models/evaluation/
ai/models/backtests/
ai/models/tuning/
ai/explanations/
models/evaluation/
models/registry.json
*.csv
# Reviewed reference tables are versioned with the code (ADR 006).
!datasets/schemas/*.csv
*.parquet
*.feather

# Processed datasets are committed only when explicitly versioned
datasets/processed/*
!datasets/processed/.gitkeep

